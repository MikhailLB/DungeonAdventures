<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- System CAs only — do NOT add user CAs (Play policy red flag). -->
            <!-- Cleartext is permitted for partner redirect chains that hop
                 through plain http:// before reaching the final https:// URL. -->
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
