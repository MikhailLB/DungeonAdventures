<?xml version="1.0" encoding="utf-8"?>
<!--
  Opts the gray module's SharedPreferences and SecureStorage out of
  Google Backup / device transfer. Without this, a restored device inherits
  a stale LaunchRoute.web from the previous install and goes straight to the
  WebView, skipping attribution — incorrect behaviour on a fresh device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
